[Desktop Entry]
Name=Status Hub
Comment=Application tray items, gathered behind a single panel button
Type=Application
Exec=cosmic-ext-applet-status-hub
Icon=io.github.marcelogomes90.cosmic-ext-applet-status-hub
Terminal=false
Categories=COSMIC;
Keywords=COSMIC;Applet;Tray;Indicator;Status;SNI;StatusNotifierItem;
NoDisplay=true
StartupNotify=true
X-CosmicApplet=true
X-CosmicShrinkable=true
X-HostWaylandDisplay=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=90
X-OverflowMinSize=1
